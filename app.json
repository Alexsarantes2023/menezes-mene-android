{
  "expo": {
    "name": "MINISTERIO WE ARE THE CHURCH",
    "slug": "menezes-mene-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0b1326"
      },
      "package": "com.menezesmene.wearethechurch"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 320,
          "resizeMode": "contain",
          "backgroundColor": "#0b1326",
          "android": {
            "image": "./assets/splash-icon.png",
            "imageWidth": 320,
            "resizeMode": "contain",
            "backgroundColor": "#0b1326"
          }
        }
      ],
      "expo-asset",
      "expo-video"
    ]
  }
}
